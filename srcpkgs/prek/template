# Template file for 'prek'
pkgname=prek
version=0.5.7
revision=1
build_style=cargo
build_helper=qemu
configure_args="--no-default-features"
make_install_args="--path crates/prek"
make_check_args="--
 --skip bun:: --skip haskell:: --skip lua:: --skip node:: --skip pygrep::
 --skip python:: --skip ruby:: --skip script:: --skip golang:: --skip julia::
 --skip swift:: --skip rust:: --skip languages:: --skip deno:: --skip dart::
 --skip perl:: --skip r:: --skip conda:: --skip coursier:: --skip php::"
depends="git"
checkdepends="git python3"
short_desc="Framework for running git pre-commit hooks"
maintainer="Alex March <alex@hosaka.cc>"
license="MIT"
homepage="https://prek.j178.dev"
changelog="https://raw.githubusercontent.com/j178/prek/refs/heads/master/CHANGELOG.md"
distfiles="https://github.com/j178/prek/archive/refs/tags/v${version}.tar.gz"
checksum=c14bfbb5121c24421aea5fbb91a9c835e3e3372e53bdaeb3dedd87cc8eda56b5

# todo: should be fixed in the upcoming versions, see:
# https://github.com/aws/aws-lc-rs/issues/1252
# https://github.com/aws/aws-lc-rs/pull/1254

# prek should use aws-lc-sys newer than 0.45.0 in the lock file to remove this

# aws-lc-sys compiles its bundled jitterentropy at -O0 and the source refuses to
# build with -O2 optimizations. This disables it in favor of getrandom(2).
export AWS_LC_SYS_NO_JITTER_ENTROPY=1

if [ "$XBPS_TARGET_WORDSIZE" = "32" ]; then
	# The test suite compares insta snapshots that were recorded on a 64-bit host.
	# They bake in the iteration order of rustc-hash maps, and rustc-hash picks a
	# different multiplier for 32-bit targets, so the snapshots never match there.
	make_check=no
fi

post_install() {
	for shell in bash fish zsh; do
		COMPLETE="${shell}" vtargetrun "${DESTDIR}/usr/bin/prek" > "prek.${shell}"
		# remove DESTDIR prefix from absolute paths that are set inside the shell
		# completion file, i.e. ${DESTDIR}/usr/bin/prek -> /usr/bin/prek
		vsed -i "s@${DESTDIR}@@g" "prek.${shell}"
		vcompletion "prek.${shell}" "${shell}"
	done

	vlicense LICENSE
}
